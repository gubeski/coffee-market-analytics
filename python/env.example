# ──────────────────────────────────────────────────────────
# .env.example — скопируй в .env и заполни своими данными
# НЕ коммить .env в git! Добавь его в .gitignore
# ──────────────────────────────────────────────────────────

# Telegram Bot API
# Токен получить у @BotFather → /newbot
TG_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# ID чата или @username канала
# Узнать ID: добавь @userinfobot в чат и напиши ему /start
TG_CHAT_ID=-1001234567890

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coffee_analytics
DB_USER=coffee_user
DB_PASSWORD=your_password_here
